<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>true</IsPackable>
    <RootNamespace>UpSparkle</RootNamespace>
    <AssemblyName>UpSparkle</AssemblyName>
    <Authors>Junian Triajianto</Authors>
    <NeutralLanguage>en</NeutralLanguage>
    <Owners>junian</Owners>
    <PackageProjectUrl>https://www.junian.dev/upsparkle/</PackageProjectUrl>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../../ReleaseNotes.txt"))</PackageReleaseNotes>
    <Summary>$(Description)</Summary>
    <PackageTags>sparkle,winsparkle,updater,macos,maccatalys,windows</PackageTags>
    <Title>UpSparkle</Title>
    <Description>Easy-to-use licensing library for .NET and .NET Framework products.</Description>
    <PackageId>UpSparkle</PackageId>
    <Copyright>Copyright (c) 2026</Copyright>
    <RepositoryUrl>https://github.com/junian/upsparkle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Standard.Licensing.snk</AssemblyOriginatorKeyFile>
    -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!--
    <PackageIcon>standard-licensing-logo.png</PackageIcon>
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CLSCompliant>True</CLSCompliant>
    
    <!-- Versions -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ReleaseVersion>$(AssemblyVersion)</ReleaseVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
	
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\README.md" Pack="true" PackagePath="\" />
    <!--
    <None Include="..\..\assets\img\standard-licensing-logo.png" Pack="true" PackagePath="\" />
    -->
  </ItemGroup>

  <!-- Expose Internals to Tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UpSparkle.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Sparkle (macOS) -->
  <ItemGroup>
    <!-- Sparkle.tar.xz: packed into the NuGet as runtimes/osx/native/Sparkle.tar.xz.
         Never copied to the output directory — extraction happens at build time on macOS
         via the ExtractSparkleFramework target below. -->
    <None Include="..\..\runtimes\osx\native\Sparkle.tar.xz"
          Pack="true"
          PackagePath="runtimes/osx/native/Sparkle.tar.xz"
          CopyToOutputDirectory="Never" />

    <!-- Sparkle.framework: present locally after running getlibs.sh / Get-Libraries.ps1.
         Used by the macOS build and for local development/testing.
         Never packed into NuGet (symlinks would be corrupted by ZIP).
         Never copied to output — the post-build target below handles that. -->
    <None Include="..\..\runtimes\osx\native\Sparkle.framework\**"
          Pack="false"
          CopyToOutputDirectory="Never">
      <Link>runtimes\osx\native\Sparkle.framework\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>

    <None Include="..\..\runtimes\osx\native\libMacSparkle.dylib"
          Pack="true"
          PackagePath="runtimes/osx/native/libMacSparkle.dylib">
      <Link>runtimes\osx\native\libMacSparkle.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Extract Sparkle.framework from Sparkle.tar.xz into the output directory.
       Only runs on macOS. Skipped if Sparkle.framework already exists there. -->
  <Target Name="ExtractSparkleFramework"
          AfterTargets="Build"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">

    <PropertyGroup>
      <_SparkleOutputDir>$(OutDir)runtimes/osx/native</_SparkleOutputDir>
      <_SparkleFrameworkDir>$(_SparkleOutputDir)/Sparkle.framework</_SparkleFrameworkDir>
      <_SparkleTarXz>$(MSBuildProjectDirectory)/../../runtimes/osx/native/Sparkle.tar.xz</_SparkleTarXz>
    </PropertyGroup>

    <MakeDir Directories="$(_SparkleOutputDir)"
             Condition="!Exists('$(_SparkleOutputDir)')" />

    <Message Text="Sparkle.framework already present at $(_SparkleFrameworkDir), skipping extraction."
             Importance="normal"
             Condition="Exists('$(_SparkleFrameworkDir)')" />

    <Exec Command="tar -xJf &quot;$(_SparkleTarXz)&quot; -C &quot;$(_SparkleOutputDir)&quot;"
          Condition="!Exists('$(_SparkleFrameworkDir)') And Exists('$(_SparkleTarXz)')" />

    <Message Text="Extracted Sparkle.framework to $(_SparkleFrameworkDir)."
             Importance="high"
             Condition="!Exists('$(_SparkleFrameworkDir)') And Exists('$(_SparkleTarXz)')" />

    <Warning Text="Sparkle.tar.xz not found at $(_SparkleTarXz). Run getlibs.sh to fetch native dependencies."
             Condition="!Exists('$(_SparkleFrameworkDir)') And !Exists('$(_SparkleTarXz)')" />
  </Target>

  <!-- WinSparkle (Windows) -->
  <ItemGroup>
    <None Include="..\..\runtimes\win-x86\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-x86/native/WinSparkle.dll">
      <Link>runtimes\win-x86\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\runtimes\win-x64\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/WinSparkle.dll">
      <Link>runtimes\win-x64\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\runtimes\win-arm64\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/WinSparkle.dll">
      <Link>runtimes\win-arm64\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
