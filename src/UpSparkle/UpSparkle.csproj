<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>true</IsPackable>
    <RootNamespace>UpSparkle</RootNamespace>
    <AssemblyName>UpSparkle</AssemblyName>
    <Authors>Junian Triajianto</Authors>
    <NeutralLanguage>en</NeutralLanguage>
    <Owners>junian</Owners>
    <PackageProjectUrl>https://www.junian.dev/upsparkle/</PackageProjectUrl>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../../ReleaseNotes.txt"))</PackageReleaseNotes>
    <Summary>$(Description)</Summary>
    <PackageTags>sparkle,winsparkle,updater,macos,maccatalys,windows</PackageTags>
    <Title>UpSparkle</Title>
    <Description>Easy-to-use updater for .NET applications. Thin .NET wrapper around WinSparkle (Windows) and Sparkle (macOS).</Description>
    <PackageId>UpSparkle</PackageId>
    <Copyright>Copyright (c) 2026</Copyright>
    <RepositoryUrl>https://github.com/junian/upsparkle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Standard.Licensing.snk</AssemblyOriginatorKeyFile>
    -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!--
    <PackageIcon>standard-licensing-logo.png</PackageIcon>
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CLSCompliant>True</CLSCompliant>
    
    <!-- Versions -->
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <PackageVersion>$(AssemblyVersion)-alpha</PackageVersion>
    <ReleaseVersion>$(AssemblyVersion)</ReleaseVersion>
    <Version>$(AssemblyVersion)</Version>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
	
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\README.md" Pack="true" PackagePath="\" />
    <!-- MSBuild targets file: imported by consuming projects automatically. -->
    <None Include="build\UpSparkle.targets" Pack="true" PackagePath="build\UpSparkle.targets" />
    <!--
    <None Include="..\..\assets\img\standard-licensing-logo.png" Pack="true" PackagePath="\" />
    -->
  </ItemGroup>

  <!-- Expose Internals to Tests -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UpSparkle.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Sparkle (macOS) -->
  <ItemGroup>
    <!-- Sparkle.tar.xz: packed into the NuGet as runtimes/osx/native/Sparkle.tar.xz.
         Never copied to the output directory — extraction happens at build time on macOS
         via the build/UpSparkle.targets file (imported by consuming projects). -->
    <None Include="..\..\runtimes\osx\native\Sparkle.tar.xz"
          Pack="true"
          PackagePath="runtimes/osx/native/Sparkle.tar.xz"
          CopyToOutputDirectory="Never" />

    <!-- Sparkle.framework: present locally after running getlibs.sh / Get-Libraries.ps1.
         Used by the macOS build and for local development/testing of UpSparkle itself.
         Never packed into NuGet (symlinks would be corrupted by ZIP).
         Copied to output during local dev builds via the Import below. -->
    <None Include="..\..\runtimes\osx\native\Sparkle.framework\**"
          Pack="false"
          CopyToOutputDirectory="Never">
      <Link>runtimes\osx\native\Sparkle.framework\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>

    <None Include="..\..\runtimes\osx\native\libMacSparkle.dylib"
          Pack="true"
          PackagePath="runtimes/osx/native/libMacSparkle.dylib">
      <Link>runtimes\osx\native\libMacSparkle.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Import build/UpSparkle.targets so the extraction logic also runs during local dev builds. -->
  <Import Project="build\UpSparkle.targets" />

  <!-- WinSparkle (Windows) -->
  <ItemGroup>
    <None Include="..\..\runtimes\win-x86\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-x86/native/WinSparkle.dll">
      <Link>runtimes\win-x86\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\runtimes\win-x64\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/WinSparkle.dll">
      <Link>runtimes\win-x64\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\runtimes\win-arm64\native\WinSparkle.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/WinSparkle.dll">
      <Link>runtimes\win-arm64\native\WinSparkle.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
