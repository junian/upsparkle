<Project>

  <!--
    ExtractSparkleFramework
    =======================
    Runs in the *consuming* project after its Build completes (on macOS only).
    Extracts Sparkle.framework from the Sparkle.tar.xz bundled in the NuGet package
    into the consumer's output runtimes/osx/native/ directory, preserving all symlinks.

    Skipped when:
      - Not running on macOS
      - $(SkipSparkleExtraction) == true  (set automatically during dotnet pack,
                                           or manually to opt out)
      - Sparkle.framework is already present in the output directory
  -->

  <Target Name="UpSparkle_SetSkipForPack" BeforeTargets="Pack">
    <PropertyGroup>
      <SkipSparkleExtraction>true</SkipSparkleExtraction>
    </PropertyGroup>
  </Target>

  <Target Name="UpSparkle_ExtractSparkleFramework"
          AfterTargets="Build"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'
                     And '$(SkipSparkleExtraction)' != 'true'">

    <!--
      $(MSBuildThisFileDirectory) resolves to the build/ folder inside the NuGet
      package cache, e.g.:
        ~/.nuget/packages/upsparkle/1.0.0/build/
      Sparkle.tar.xz sits at:
        ~/.nuget/packages/upsparkle/1.0.0/runtimes/osx/native/Sparkle.tar.xz
    -->
    <PropertyGroup>
      <_UpSparkle_PackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../'))</_UpSparkle_PackageRoot>
      <_UpSparkle_TarXz>$(_UpSparkle_PackageRoot)runtimes/osx/native/Sparkle.tar.xz</_UpSparkle_TarXz>
      <_UpSparkle_OutputDir>$(OutDir)runtimes/osx/native</_UpSparkle_OutputDir>
      <_UpSparkle_FrameworkDir>$(_UpSparkle_OutputDir)/Sparkle.framework</_UpSparkle_FrameworkDir>
    </PropertyGroup>

    <MakeDir Directories="$(_UpSparkle_OutputDir)"
             Condition="!Exists('$(_UpSparkle_OutputDir)')" />

    <Message Text="[UpSparkle] Sparkle.framework already present at $(_UpSparkle_FrameworkDir), skipping extraction."
             Importance="normal"
             Condition="Exists('$(_UpSparkle_FrameworkDir)')" />

    <Exec Command="tar -xJf &quot;$(_UpSparkle_TarXz)&quot; -C &quot;$(_UpSparkle_OutputDir)&quot;"
          Condition="!Exists('$(_UpSparkle_FrameworkDir)') And Exists('$(_UpSparkle_TarXz)')" />

    <Message Text="[UpSparkle] Extracted Sparkle.framework to $(_UpSparkle_FrameworkDir)."
             Importance="high"
             Condition="!Exists('$(_UpSparkle_FrameworkDir)') And Exists('$(_UpSparkle_TarXz)')" />

    <Warning Text="[UpSparkle] Sparkle.tar.xz not found at $(_UpSparkle_TarXz). The NuGet package may be corrupt or incomplete."
             Condition="!Exists('$(_UpSparkle_FrameworkDir)') And !Exists('$(_UpSparkle_TarXz)')" />

  </Target>

</Project>
