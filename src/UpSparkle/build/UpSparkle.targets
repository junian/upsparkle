<Project>

  <PropertyGroup>
    <_SparkleArchive>$(MSBuildThisFileDirectory)Sparkle.tar.xz</_SparkleArchive>
    <_SparkleRoot>$(IntermediateOutputPath)UpSparkle</_SparkleRoot>
    <_SparkleFramework>$(_SparkleRoot)\Sparkle.framework</_SparkleFramework>
  </PropertyGroup>

  <Target Name="UpSparkleExtractSparkle"
          BeforeTargets="ResolveReferences"
          Condition="'$(OS)' == 'Unix' and Exists('$(_SparkleArchive)')">

    <MakeDir Directories="$(_SparkleRoot)" />

    <Exec Command="tar -xJf &quot;$(_SparkleArchive)&quot; -C &quot;$(_SparkleRoot)&quot;" />

    <ItemGroup>
      <None Include="$(_SparkleFramework)\**">
        <Link>runtimes\osx\native\Sparkle.framework\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

  </Target>

</Project>
